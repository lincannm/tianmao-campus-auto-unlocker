<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ `accessibilityFeedbackType` **必须是** `feedbackAllMask`（含 SPOKEN / BRAILLE，即"读屏类"）：
  HyperOS 的「最近任务划掉卡片」＝ force-stop，而强停必清无障碍授权（AOSP 设计，没有 flag 豁免）；
  它的清理会跳过"看起来像读屏"的无障碍服务，所以只有声明成读屏类才不会被那个手势强停。
  同一个值在 UnlockAccessibilityService.onServiceConnected() 里还会被钉一遍。
  改这个值之前先跑 work/v3/swipe_kill_test.ps1 复验（见 ../AGENTS.md §3.6）。

  说明：
  - canRetrieveWindowContent 必须为 true，否则拿不到控件树（WebView 里的「跳过」也就看不见）。
  - flagRetrieveInteractiveWindows 让服务能看到当前交互窗口。
  - 不在这里写 packageNames：包名过滤放在代码里做，便于以后按需放宽。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackAllMask"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/service_desc"
    android:summary="@string/service_desc" />
