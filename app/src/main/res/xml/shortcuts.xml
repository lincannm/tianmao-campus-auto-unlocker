<?xml version="1.0" encoding="utf-8"?>
<!--
  静态快捷方式：长按桌面图标 -> 设置。这是用户进入设置面板的**唯一入口**，所以它是必需的。
  targetClass 必须写全限定名；shortcutIcon 用**专用**的齿轮图标
  （`drawable-*dpi/ic_shortcut_settings.png`，由 `tools/make_icons.py` 生成）。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.fucktmall.unlockassistant.SettingsActivity"
            android:targetPackage="com.fucktmall.unlockassistant" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
