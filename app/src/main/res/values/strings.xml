<resources>
    <!--
      这里是**给系统看的**文案：应用名、无障碍服务名/说明、桌面快捷方式标签、toast。
      界面文案（向导、设置、对话框）已经全部搬进 Compose 代码里的 stringResource，
      见 app/src/main/java/.../ui/*.kt；下面凡是只给 Compose 用的条目都留在这，
      删掉了旧 XML 布局专用的那一批（避免出现两套已经对不上的向导文案）。

      3.0 起应用名从「一键开门」改成「开锁」（用户要求），本文件里所有自称都要跟着改。
    -->
    <string name="app_name">开锁</string>

    <!-- 快捷方式 -->
    <string name="shortcut_settings_short">设置</string>
    <string name="shortcut_settings_long">打开设置与动作日志</string>

    <!--
      首次使用的 toaster：**故意只说一句话，不替用户做任何事**。
      目的是让用户自己知道「设置在哪」——所以文案里必须点名"长按桌面图标"。
    -->
    <string name="toast_first_run">初次使用：长按桌面「开锁」图标 → 点「设置」完成向导</string>

    <!-- 向导 -->
    <string name="wiz_title">初次使用向导</string>
    <string name="wiz_step_fmt">第 %1$d 步 / 共 %2$d 步</string>
