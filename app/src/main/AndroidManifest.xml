<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      包可见性：Android 11+ 默认看不到别的 App。
      这里只声明我们要问的那两个包，比申请 QUERY_ALL_PACKAGES 干净得多。
    -->
    <queries>
        <package android:name="com.tmall.campus.and" />
        <!--
          只服务一件事：「打开 Shizuku」按钮（ShizukuA11y.openShizuku 用
          PackageManager.getLaunchIntentForPackage，没有这条声明在 Android 11+ 上必然返回 null）。
          ⚠️ **本App 不检测 Shizuku 装没装**：查不准，会把已经装了的人引去「再装一个」。
          `ShizukuA11y.state()` 只看 binder 与授权；这个按钮找不到启动入口时退回下载直链。
        -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- 向导第 2 步要直接申请「忽略电池优化」，避免服务被系统杀掉后无障碍掉线。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      ⭐ 3.3 新增，用途**只有一个**：「了解本App」页里点 GitHub 仓库卡，把链接交给浏览器。
      Android 规定**发起方的 App 自己**要有 INTERNET 才有资格 resolve/启动 http(s) 的
      ACTION_VIEW（否则 SecurityException），所以不加这条权限，那一下点击必然失败。
      本App **没有任何联网代码、没有网络库**，这条权限不会被用在别处；
      「自己不申请特权权限、不联网」的定位不变。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ⚠️ **实验包专用（3.11-exp1）**：这条权限是用来测「Shizuku 能不能替我们 `pm grant` 它」。
      它**不是**交付形态 —— 交付物一条特权权限都不申请（见 ../AGENTS.md §2 第 6 条）。
      这条权限的 protectionLevel 是 `signature|privileged|development|installer|role`，
      带 `development` 标记 ⇒ adb / shell（uid 2000，Shizuku 的服务就是）可以 `pm grant` 给任何
      **在清单里声明过它**的 App。测完不管结论如何都要把它删掉，或者按结论改成正式方案。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!--
      本App **不申请** `WRITE_SECURE_SETTINGS`：无障碍被系统清掉之后，
      「写回开关」这件事由 Shizuku 以 shell 身份做（见 ShizukuA11y.kt），本App 自己只读系统设置。
      用户没打开「用 Shizuku 保持无障碍开启」那个开关时，一行都不写。
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnlockAssistant">

        <!--
          桌面入口。没走完初次使用向导时**只弹一句 toast**（什么都不做，见 MainActivity），
          走完之后默认自动抛 deep link 进开锁界面。
          meta-data android.app.shortcuts 提供「长按图标 -> 设置」（向导也在那里）。

          注：这里**没有**用 excludeFromRecents 去躲开「最近任务划掉」——
          实测 HyperOS 3 不认它（桌面自己打印 isExcludedFromRecents=true，卡片照旧显示），
          见 docs/40-pitfalls.md §3.2。划掉 = force-stop 这件事靠服务的 feedbackAllMask 声明挡住
          （docs/20-core-mechanisms-and-invariants.md §1）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          设置面板（未 onboarded 时它显示的是初次使用向导）。
          exported=true 是静态快捷方式能拉起它的前提（快捷方式由桌面以外部身份启动）。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/set_title"
            android:launchMode="singleTop" />

        <!--
          「了解本App」整页（3.3：从设置页的弹窗改成独立 Activity，用户要求）。
          exported=false：只有本App 自己会拉起它（设置页顶卡那个按钮），
          没有 deep link、也不给别的 App 入口 —— 能少一个入口就少一个。
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:launchMode="singleTop" />

        <!--
          「小组件添加至桌面」引导页：先引导授「桌面快捷方式」权限，再调系统的「固定小部件」请求。
          exported=false：只有设置页那个空心按钮会拉起它。
        -->
        <activity
            android:name=".WidgetPinActivity"
            android:exported="false"
            android:label="@string/wpin_title"
            android:launchMode="singleTop" />

        <!--
          ⚠️ **实验包专用（3.11-exp1）**：无界面的权限探针，只用来回答「不经过 Shizuku，本App 自己能不能写
          Settings.Secure」（见 PermProbeActivity）。`exported=true` 是为了能用 adb 拉起来测，
          **交付前这个 activity 与对应的类都要删掉**。
        -->
        <activity
            android:name=".PermProbeActivity"
            android:exported="true"
            android:label="@string/shzg_title"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Shizuku 引导页：向导第 1 步与设置面板里那个「通过Shizuku开启无障碍（推荐）」都跳到这。
          exported=false：只有本App 自己会拉起它（这一页要放视频教程入口与一张可全屏放大的路径图，
          所以是独立整页而不是弹窗）。
        -->
        <activity
            android:name=".ShizukuGuideActivity"
            android:exported="false"
            android:label="@string/shzg_title"
            android:launchMode="singleTop" />

        <!--
          桌面小部件（3.1）：四张独立卡，1×1 / 2×1 / 2×2 / 4×2，每张放置后都能自由缩放。
          每个入口一个子类（同名 receiver 在清单里会被合并，没法用一个类挂四份 meta-data）。
          exported=false：小部件的更新广播由系统投递，外部 App 没有理由触发它
          （官方 AppWidget 示例也是 false）。
        -->
        <receiver
            android:name=".widget.UnlockWidget1x1"
            android:exported="false"
            android:label="@string/widget_name_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_1x1_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget2x1"
            android:exported="false"
            android:label="@string/widget_name_2x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_2x1_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget2x2"
            android:exported="false"
            android:label="@string/widget_name_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_2x2_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget4x2"
            android:exported="false"
            android:label="@string/widget_name_4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_4x2_info" />
        </receiver>

        <!--
          「小部件真的加到桌面上了」的回调（`requestPinAppWidget` 的 successCallback 打过来）。
          exported=false：发它的是我们自己创建的那个 PendingIntent，外部 App 没有理由触发它。
        -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!--
          Shizuku 的 binder 入口：进程启动时 Shizuku 通过它把 binder 交给我们，
          没有它 `Shizuku` 类的每个方法都会抛 "binder haven't been received"。
          `permission` 是**要求调用方持有**的权限（不是我们申请权限），
          `authorities` 必须是 `<applicationId>.shizuku`，这两条都是 Shizuku 官方约定的写法。
          provider 这个依赖还会往合并后的清单里注入 `moe.shizuku.manager.permission.API_V23`
          （这条权限名属于 Shizuku 的 API 约定，与「管理器 App 的包名」是两回事，别拿它去推包名）。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          弹窗清理服务。
          permission 必须是 BIND_ACCESSIBILITY_SERVICE：只有系统能绑它，
          普通 App 绑不上，这是无障碍服务的安全边界。
        -->
        <service
            android:name=".UnlockAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
