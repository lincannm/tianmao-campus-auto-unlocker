<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      包可见性：Android 11+ 默认看不到别的 App。
      这里只声明我们要问的那一个包，比申请 QUERY_ALL_PACKAGES 干净得多。
    -->
    <queries>
        <package android:name="com.tmall.campus.and" />
    </queries>

    <!-- 向导第 2 步要直接申请「忽略电池优化」，避免服务被系统杀掉后无障碍掉线。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      ⭐ 3.3 新增，用途**只有一个**：「了解本App」页里点 GitHub 仓库卡，把链接交给浏览器。
      Android 规定**发起方的 App 自己**要有 INTERNET 才有资格 resolve/启动 http(s) 的
      ACTION_VIEW（否则 SecurityException），所以不加这条权限，那一下点击必然失败。
      本App **没有任何联网代码、没有网络库**，这条权限不会被用在别处；
      「零特权、不联网」的定位不变（见 README 与 docs/20-core-mechanisms-and-invariants.md）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ⭐ 3.0 起**不再**申请 WRITE_SECURE_SETTINGS（用户要求去掉「系统清掉授权自动恢复」）。
      2.1 加它，是为了在授权被强停清掉后自己写回系统设置；2.2 已经用
      `feedbackAllMask`（见 accessibility_service_config.xml）让「划掉卡片」不再强停本App，
      用户又明确不要那个功能，所以申请、代码、面板开关一起删掉。
      现在本App 对系统设置**只读不写**：少一条特权权限，也少一处可能抢用户开关的地方。
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnlockAssistant">

        <!--
          桌面入口。没走完初次使用向导时**只弹一句 toast**（什么都不做，见 MainActivity），
          走完之后默认自动抛 deep link 进开锁界面。
          meta-data android.app.shortcuts 提供「长按图标 -> 设置」（向导也在那里）。

          注：这里**没有**用 excludeFromRecents 去躲开「最近任务划掉」——
          实测 HyperOS 3 不认它（桌面自己打印 isExcludedFromRecents=true，卡片照旧显示），
          见 docs/40-pitfalls.md §3.2。划掉 = force-stop 这件事靠服务的 feedbackAllMask 声明挡住
          （docs/20-core-mechanisms-and-invariants.md §1）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          设置面板（未 onboarded 时它显示的是初次使用向导）。
          exported=true 是静态快捷方式能拉起它的前提（快捷方式由桌面以外部身份启动）。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/set_title"
            android:launchMode="singleTop" />

        <!--
          「了解本App」整页（3.3：从设置页的弹窗改成独立 Activity，用户要求）。
          exported=false：只有本App 自己会拉起它（设置页顶卡那个按钮），
          没有 deep link、也不给别的 App 入口 —— 能少一个入口就少一个。
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:launchMode="singleTop" />

        <!--
          桌面小部件（3.1）：四张独立卡，1×1 / 2×1 / 2×2 / 4×2，每张放置后都能自由缩放。
          每个入口一个子类（同名 receiver 在清单里会被合并，没法用一个类挂四份 meta-data）。
          exported=false：小部件的更新广播由系统投递，外部 App 没有理由触发它
          （官方 AppWidget 示例也是 false）。
        -->
        <receiver
            android:name=".widget.UnlockWidget1x1"
            android:exported="false"
            android:label="@string/widget_name_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_1x1_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget2x1"
            android:exported="false"
            android:label="@string/widget_name_2x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_2x1_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget2x2"
            android:exported="false"
            android:label="@string/widget_name_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_2x2_info" />
        </receiver>

        <receiver
            android:name=".widget.UnlockWidget4x2"
            android:exported="false"
            android:label="@string/widget_name_4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unlock_4x2_info" />
        </receiver>

        <!--
          弹窗清理服务。
          permission 必须是 BIND_ACCESSIBILITY_SERVICE：只有系统能绑它，
          普通 App 绑不上，这是无障碍服务的安全边界。
        -->
        <service
            android:name=".UnlockAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
